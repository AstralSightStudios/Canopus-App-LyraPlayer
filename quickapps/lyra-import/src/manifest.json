{
  "package": "com.canopus.lyraimport",
  "name": "Lyra Import",
  "versionName": "1.0.1",
  "versionCode": 2,
  "minPlatformVersion": 1200,
  "icon": "/common/logo.png",
  "simulationVersion": "default",
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.interconnect" },
    { "name": "system.file" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": "device-width"
  },
  "display": {
    "backgroundColor": "#000000"
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": { "component": "index" }
    }
  }
}
